# Resend (https://resend.com) — used by src/app/api/contact/route.ts to deliver
# contact-form submissions by email. Get an API key from the Resend dashboard.
RESEND_API_KEY=

# Sender identity for outgoing emails. Using Resend's default sandbox sender
# (onboarding@resend.dev) works without verifying a domain, but Resend will
# then only deliver to the email address of the Resend account itself.
# Verify a domain in Resend and set this to an address on that domain to send
# to any destination.
RESEND_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"

# Destination inbox for contact-form submissions. Defaults to the email
# already configured in src/data/profile.ts if not set.
CONTACT_EMAIL=anshuman.jha325@gmail.com
